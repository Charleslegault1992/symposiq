{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(npx prisma migrate reset *"
    ],
    "ask": ["Bash(npm install *)", "Bash(npm i *)", "Bash(git push *)"],
    "allow" : [
        "Bash(npm test)",
        "Bash(npm run lint)",
        "Bash(npx prisma validate)"
    ]
  }
}
